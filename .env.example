# 服务端口
PORT=3001

# ===== 前端开发配置 =====
VITE_API_BASE_URL=http://localhost:3001

# ===== CORS 配置（可选） =====
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ===== 静态文件目录（可选，部署时使用） =====
# VIDEO2_DIST_DIR=./dist

# ===== 阿里云配置 =====
# 同一组 AccessKey 同时用于以下服务：
#   1. OSS 对象存储（文件上传/下载）
#   2. 视频视觉智能 API（视频分割 SplitVideoParts）
#   3. MPS 媒体处理（视频转码/压缩）
#
# RAM 权限要求（3个）：
#   - AliyunOSSFullAccess
#   - AliyunVIAPIFullAccess （视频分割）
#   - AliyunMTSFullAccess    （视频压缩）
#
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
OSS_BUCKET=your_oss_bucket_name
OSS_REGION=oss-cn-beijing

# 开发环境阿里云配置（可选，用于区分开发/生产）
# ALIYUN_ACCESS_KEY_ID_DEV=
# ALIYUN_ACCESS_KEY_SECRET_DEV=
# OSS_BUCKET_DEV=
# OSS_REGION_DEV=

# 阿里云 MPS 管道 ID（可选，用于视频转码压缩任务队列）
# 需在阿里云 MPS 控制台创建管道后填入
# MPS_PIPELINE_ID=your_mps_pipeline_id

# ===== AI 平台 API Key =====
# GeekAI（首选）
GEEKAI_API_KEY=your_geekai_api_key

# 硅基流动 SiliconFlow（备选降级）
SILICONFLOW_API_KEY=your_siliconflow_api_key
